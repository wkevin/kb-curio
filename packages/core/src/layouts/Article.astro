---
import { loadKbCurioConfig } from '../load-config.ts';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  pubDate?: Date;
  fetchDate?: Date;
  date?: Date;
  updatedDate?: Date;
  author?: string | number;
  media?: string;
  translator?: string;
  source?: string;
  url?: string;
  topics?: string[];
  tags?: string[];
  headings?: Heading[];
}

const {
  title,
  description,
  pubDate,
  fetchDate,
  date,
  updatedDate,
  author,
  media,
  translator,
  source,
  url,
  topics: topicIds = [],
  tags = [],
  headings = [],
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const articleDate = pubDate || date;

// Resolve topic IDs → names from project config. Routing layer passes IDs;
// this layout owns the lookup so consumers don't need to know how topics
// are stored.
const cfg = await loadKbCurioConfig();
const topics = topicIds
  .map((id) => {
    const t = cfg.topics.find((x) => x.id === id);
    return t ? { id: t.id, name: t.name } : { id, name: id };
  })
  .filter((t, i, arr) => arr.findIndex((x) => x.id === t.id) === i);

// Source enum → human label (kept for consistency with other layouts).
const sourceLabels: Record<string, string> = {
  'social-media': '社交媒体',
  'industry-reports': '行业报告',
  'academic-papers': '学术论文',
  'conference-talks': '会议演讲',
};

// TOC: h2 and h3 entries only. Slugs come from Astro's built-in slugger;
// we render the heading text as-is so writers' numbering ("1.", "2.", etc.)
// flows through naturally (arxiv does the same).
const tocEntries = headings.filter((h) => h.depth === 2 || h.depth === 3);

function fmtZh(d: Date | string | undefined): string {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
function fmtIso(d: Date | string | undefined): string {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  if (Number.isNaN(date.getTime())) return '';
  return date.toISOString();
}
const pubStr = fmtZh(articleDate);
const fetchStr = fmtZh(fetchDate);
const updStr = fmtZh(updatedDate);
const authorLabel = media && author ? `${author} @ ${media}` : author;
const sourceLabel = source ? (sourceLabels[source] ?? source) : '';
---
<BaseLayout title={title || '文章'} description={description} activeTopics={topicIds}>
  <article class="article">
    <header class="article-header">
      {topics.length > 0 && (
        <nav class="article-topics" aria-label="话题">
          {topics.map((t) => (
            <a href={`${base}article/?topic=${encodeURIComponent(t.id)}`} class="article-topic">{t.name}</a>
          ))}
        </nav>
      )}
      <h1 class="article-title">{title}</h1>
      {description && <p class="article-summary">{description}</p>}
      <div class="article-authors">
        {authorLabel && <span class="article-author">{authorLabel}</span>}
        {pubStr && (
          <span class="article-meta-item">
            <time datetime={fmtIso(articleDate)}>{pubStr}</time>
          </span>
        )}
        {sourceLabel && <span class="article-meta-item">{sourceLabel}</span>}
        {url && (
          <a href={url} target="_blank" rel="noopener noreferrer" class="article-meta-item article-meta-item--link">原文</a>
        )}
      </div>
      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map((t) => (
            <a href={`${base}tags/${encodeURIComponent(t)}`} class="article-tag">#{t}</a>
          ))}
        </div>
      )}
      {(fetchStr && fetchStr !== pubStr) && (
        <p class="article-stamp">收录：{fetchStr}</p>
      )}
    </header>

    <div class="article-body-wrap">
      {tocEntries.length > 0 && (
        <aside class="article-toc" aria-label="目录">
          <ul class="article-toc__list">
            {tocEntries.map((h) => (
              <li class={`article-toc__item article-toc__item--depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
      <div class="article-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 1200px;
    margin: 0 auto;
    /* No horizontal padding — this wrapper is also used by the article list
       page, where we want items to extend to the same right edge as the
       header's theme icon (which sits at `viewport - 2rem` because of
       the header nav's padding). A 1.5rem horizontal padding here would
       shift the list right edge inward by 32px and break that alignment.
       The detail page's body content is already constrained by the
       body-wrap grid, so removing this padding doesn't hurt readability. */
    padding: 2rem 0 4rem;
  }

  /* Header ───────────────────────────────────────────── */
  .article-header {
    max-width: 760px;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .article-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .article-topic {
    color: var(--accent);
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .article-topic:hover {
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  .article-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    line-height: 1.3;
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.005em;
  }

  .article-summary {
    margin: 0 0 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    font-weight: 400;
    text-align: center;
  }

  .article-authors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin: 0.75rem 0 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .article-author {
    color: var(--text);
    font-weight: 500;
  }
  .article-meta-item {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .article-meta-item--link {
    color: var(--accent);
  }
  .article-meta-item--link:hover {
    text-decoration: underline;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .article-tag {
    color: var(--accent);
    font-size: 0.82rem;
    text-decoration: none;
  }
  .article-tag:hover {
    text-decoration: underline;
  }

  .article-stamp {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-style: italic;
  }

  /* Body + TOC layout ────────────────────────────────── */
  /* Default: single column. Only switch to a 2-column TOC+body grid
     when the TOC is actually rendered — using :has(> aside.article-toc).
     This avoids wrapping a list page (which has no TOC) in a 220px empty
     sidebar that shrinks the inner minmax(0,1fr) column to its min-content. */
  .article-body-wrap {
    max-width: 1200px;
    margin: 0 auto;
  }
  .article-body-wrap:has(> aside.article-toc) {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .article-toc {
    position: sticky;
    top: 2rem;
    align-self: start;
    font-size: 0.85rem;
    line-height: 1.5;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }
  .article-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .article-toc__item {
    margin: 0;
    padding: 0;
  }
  .article-toc__item a {
    display: block;
    padding: 0.25rem 0;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .article-toc__item a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .article-toc__item--depth-3 a {
    padding-left: 1rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.75;
  }

  .article-body {
    min-width: 0;
    margin: 0 auto;
    line-height: 1.65;
    color: var(--text);
    font-size: 1rem;
    /* No max-width here on purpose: the list page renders inside
       .article-body too, and constraining to 760px would squeeze the
       article items' title column. The detail page's body is naturally
       constrained by .article-body-wrap's grid (220px sidebar + 1fr ≈
       740px on desktop) which already gives a comfortable reading
       width. */
  }

  /* Abstract section — first 4 children of .article-body are
     核心观点 (p + ol) and 延伸洞察 (p + ol). Style them as a single
     "Abstract" block with subtle bg + tighter spacing, mirroring
     arxiv's abstract treatment. Use adjacent sibling selectors so
     we don't need a remark plugin to wrap the elements. */
  .article-body > p:nth-of-type(1),
  .article-body > p:nth-of-type(1) + ol,
  .article-body > p:nth-of-type(2),
  .article-body > p:nth-of-type(2) + ol {
    background: var(--bg-secondary);
  }
  .article-body > p:nth-of-type(1) {
    margin: 0 0 0.5rem;
    padding: 1.25rem 1.5rem 0.25rem;
    border-radius: 6px 6px 0 0;
    font-weight: 500;
    color: var(--text);
  }
  .article-body > p:nth-of-type(1) + ol {
    margin: 0 0 0.5rem;
    padding: 0 1.5rem 0.75rem 2.5rem;
    border-radius: 0;
  }
  .article-body > p:nth-of-type(2) {
    margin: 0;
    padding: 0.75rem 1.5rem 0.25rem;
    font-weight: 500;
    color: var(--text);
  }
  .article-body > p:nth-of-type(2) + ol {
    margin: 0 0 1.5rem;
    padding: 0 1.5rem 1.25rem 2.5rem;
    border-radius: 0 0 6px 6px;
  }

  /* Body typography ──────────────────────────────────── */
  .article-body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }
  .article-body :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }
  .article-body :global(p) {
    margin: 0.85rem 0;
  }
  .article-body :global(blockquote) {
    margin: 1rem 0;
    padding: 0 0 0 1rem;
    border-left: 3px solid var(--border);
    color: var(--text-secondary);
    font-style: italic;
  }
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.25rem auto;
    display: block;
    border-radius: 4px;
  }
  .article-body :global(code) {
    background: var(--bg-tertiary);
    color: var(--text);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-size: 0.92em;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
  .article-body :global(pre) {
    background: var(--pre-bg);
    color: var(--pre-text);
    padding: 0.85rem 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1rem 0;
    line-height: 1.5;
    font-size: 0.9em;
  }
  .article-body :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5rem;
    margin: 0.85rem 0;
  }
  .article-body :global(li) {
    margin: 0.35rem 0;
  }
  .article-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.15em;
  }
  .article-body :global(.highlight) {
    padding: 1px 4px;
    border-radius: 3px;
  }
  [data-theme='light'] .article-body :global(.highlight) {
    background-color: #fff3cd;
  }
  [data-theme='dark'] .article-body :global(.highlight) {
    background-color: #4b5563;
  }
  .article-body :global(hr) {
    margin: 2rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.95rem;
  }
  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .article-body :global(th) {
    background: var(--bg-secondary);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .article-body-wrap:has(> aside.article-toc) {
      grid-template-columns: 1fr;
    }
    .article-toc {
      position: static;
      max-height: none;
      order: -1;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.8rem;
      columns: 2;
      column-gap: 2rem;
    }
    .article-toc__item--depth-3 a {
      padding-left: 0;
    }
  }
</style>