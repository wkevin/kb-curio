---
import { loadKbCurioConfig } from '../load-config.ts';

interface Props {
  title?: string;
  description?: string;
  // Optional: topics the current page "belongs to". The detail page passes
  // its article's `topics` here so the header can highlight the matching
  // nav link even when the URL has no `?topic=` query string. The list
  // page's topic highlight is driven by `?topic=` instead (handled in the
  // header script below for static builds).
  activeTopics?: string[];
}

// Load project config for site title/description defaults.
const cfg = await loadKbCurioConfig();

const {
  title = cfg.site.title,
  description = cfg.site.description ?? `${cfg.site.title} — a kb-curio knowledge base.`,
  activeTopics = [],
} = Astro.props;

// 获取 base 路径前缀
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const pathname = Astro.url.pathname.replace(/\/$/, '');
const isHome = pathname === base.replace(/\/$/, '') || pathname === '';
const isArticleIndex = pathname === `${base}article`;
const urlTopic = isArticleIndex ? Astro.url.searchParams.get('topic') : null;
// Union URL-driven and prop-driven highlights so both paths paint the same
// state on initial render (SSR); the client script below reconciles again
// on navigation.
const highlightTopics = Array.from(new Set([...(urlTopic ? [urlTopic] : []), ...activeTopics]));

// Sort state — read at build/render time for the initial active class and
// the toggle's target hrefs. The client script below re-applies this on
// `popstate` so the toggle stays in sync with browser back/forward.
//
// `hasListOnPage` distinguishes pages that can sort in place (home / list)
// from pages that must navigate to the list to apply sort (detail). The
// client script uses the same flag to decide between pushState and a
// full-page navigation when the toggle is clicked.
const sortMode: 'fetch' | 'pub' = Astro.url.searchParams.get('sort') === 'pub' ? 'pub' : 'fetch';
const hasListOnPage = isHome || isArticleIndex;
const sortToggleHref = (mode: 'fetch' | 'pub'): string => {
  const params = new URLSearchParams();
  if (urlTopic) params.set('topic', urlTopic);
  if (mode !== 'fetch') params.set('sort', 'pub');
  const qs = params.toString();
  // Stay on the current path when it has a list; only the query string
  // changes. On detail pages, fall through to the article list so the
  // sort can take effect.
  if (hasListOnPage) {
    const path = isHome ? base : `${base}article/`;
    return `${path}${qs ? `?${qs}` : ''}`;
  }
  return `${base}article/${qs ? `?${qs}` : ''}`;
};

// GitHub repo URL — read from project config, or hide the icon when absent.
const githubUrl = cfg.site.github;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // 主题初始化脚本 - 必须内联以避免闪烁
      ;(function () {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a href={base} class={isHome ? 'nav-link nav-link--active' : 'nav-link'}>首页</a>
        {cfg.topics.map((topic) => (
          <a
            href={`${base}article/?topic=${encodeURIComponent(topic.id)}`}
            class={highlightTopics.includes(topic.id) ? 'nav-link nav-link--active' : 'nav-link'}
            title={topic.description}
            data-topic={topic.id}
          >{topic.name}</a>
        ))}
        <a href={`${base}rss.xml`} class="rss-link">
          <svg
            class="rss-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
        </a>
        <a
          href={sortToggleHref(sortMode === 'fetch' ? 'pub' : 'fetch')}
          class="sort-icon"
          title={`按${sortMode === 'fetch' ? '收录' : '发布'}时间排序 · 点击切换`}
          aria-label="切换排序方式"
          data-sort-toggle={sortMode}
          data-sort-stay={hasListOnPage ? 'true' : 'false'}
        >
          <svg
            class="sort-icon__fetch"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
            <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
          </svg>
          <svg
            class="sort-icon__pub"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </a>
        {githubUrl && (
          <a href={githubUrl} class="github-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg
              class="github-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
        )}
        <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
          <svg
            class="sun-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="moon-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 kb-curio</p>
    </footer>
    <script is:inline>
      // Header state that can't be SSR'd on a static build:
      //   1. Topic highlight — the list page is statically rendered without
      //      ?topic= query, so the matching nav link gets --active only
      //      after this script reads the live URL.
      //   2. Sort toggle morph — both SVG icons live in the DOM; this
      //      script flips the [data-sort-toggle] attribute so CSS shows
      //      the right one. The non-default mode also paints the accent
      //      background via the same attribute selector.
      //   3. List re-ordering — when the user picks a sort via the header
      //      icon, pushState changes the URL but the page doesn't re-render
      //      (static build), so we resort the [data-article-list] DOM in
      //      place using the data-pub-date / data-fetch-date attributes.
      //      On pages without a list (detail), the click falls through to
      //      a normal <a> navigation toward the article list.
      //
      // This block is plain JS (no TS) — see the article-list page's
      // inline script for the same constraint.
      function currentSort() {
        return new URLSearchParams(location.search).get('sort') === 'pub' ? 'pub' : 'fetch';
      }

      function applyNavState() {
        var params = new URLSearchParams(location.search);
        var topic = params.get('topic');
        var sort = currentSort();
        document.querySelectorAll('header nav [data-topic]').forEach(function (a) {
          a.classList.toggle('nav-link--active', !!topic && a.dataset.topic === topic);
        });
        document.querySelectorAll('header nav [data-sort-toggle]').forEach(function (a) {
          a.setAttribute('data-sort-toggle', sort);
          a.title = (sort === 'fetch' ? '按收录时间排序' : '按发布时间排序') + ' · 点击切换';
        });
      }

      function applyListSort() {
        var list = document.querySelector('[data-article-list]');
        if (!list) return;
        var sort = currentSort();
        var items = Array.prototype.slice.call(list.querySelectorAll('.article-item'));
        if (items.length < 2) return;
        items.sort(function (a, b) {
          var aKey = sort === 'pub' ? a.dataset.pubDate : (a.dataset.fetchDate || a.dataset.pubDate);
          var bKey = sort === 'pub' ? b.dataset.pubDate : (b.dataset.fetchDate || b.dataset.pubDate);
          if (!aKey && !bKey) return 0;
          if (!aKey) return 1;
          if (!bKey) return -1;
          return bKey.localeCompare(aKey);
        });
        items.forEach(function (item) { list.appendChild(item); });
      }

      // Build the toggle's target URL from `location` so every query
      // param the user currently has (topic, etc.) is preserved. The
      // SSR-computed `a.href` is best-effort only — on static builds and
      // in dev mode, Astro.url.searchParams is empty at SSR time, so the
      // href can't carry `?topic=...`. Reading from `location` always
      // gives the live, full URL.
      function buildSortToggleHref() {
        var newMode = currentSort() === 'fetch' ? 'pub' : 'fetch';
        var newParams = new URLSearchParams(location.search);
        if (newMode === 'fetch') {
          newParams.delete('sort');
        } else {
          newParams.set('sort', 'pub');
        }
        var qs = newParams.toString();
        return location.pathname + (qs ? '?' + qs : '');
      }

      // In-place toggle: pages with a [data-article-list] re-sort without
      // a full reload. The <a> href is a real URL (rewritten below) so
      // right-click → open in new tab also lands correctly.
      function bindSortToggle(a) {
        a.addEventListener('click', function (e) {
          if (a.getAttribute('data-sort-stay') !== 'true') return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (e.button !== 0) return;
          e.preventDefault();
          var newUrl = buildSortToggleHref();
          history.pushState({}, '', newUrl);
          // Re-paint this single element so the icon flips immediately,
          // then refresh() to also catch any other [data-sort-toggle]
          // mirrors (none today, but future-proof) and the article list.
          a.setAttribute('data-sort-toggle', currentSort());
          a.title =
            (currentSort() === 'fetch' ? '按收录时间排序' : '按发布时间排序') +
            ' · 点击切换';
          applyListSort();
        });
      }

      // Keep the visible href in sync with the live URL — right-click /
      // middle-click / no-JS users land on a URL that matches what the
      // button would have done with JS.
      function syncSortToggleHrefs() {
        var href = buildSortToggleHref();
        document
          .querySelectorAll('header nav [data-sort-toggle]')
          .forEach(function (a) {
            a.setAttribute('href', href);
          });
      }

      function refresh() {
        applyNavState();
        applyListSort();
        syncSortToggleHrefs();
      }

      document
        .querySelectorAll('header nav [data-sort-toggle]')
        .forEach(bindSortToggle);

      window.addEventListener('DOMContentLoaded', refresh);
      window.addEventListener('popstate', refresh);
    </script>
  </body>
</html>

<script>
  // 主题切换脚本
  const themeToggle = document.getElementById('theme-toggle')
  const html = document.documentElement

  // 更新图标显示
  function updateIcon(theme: string) {
    const sunIcon = themeToggle?.querySelector('.sun-icon') as HTMLElement
    const moonIcon = themeToggle?.querySelector('.moon-icon') as HTMLElement
    if (sunIcon && moonIcon) {
      if (theme === 'dark') {
        sunIcon.style.display = 'none'
        moonIcon.style.display = 'block'
      } else {
        sunIcon.style.display = 'block'
        moonIcon.style.display = 'none'
      }
    }
  }

  // 初始化图标状态
  updateIcon(html.getAttribute('data-theme') || 'light')

  // 主题切换处理
  themeToggle?.addEventListener('click', () => {
    const currentTheme = html.getAttribute('data-theme') || 'light'
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark'

    html.setAttribute('data-theme', newTheme)
    localStorage.setItem('theme', newTheme)
    updateIcon(newTheme)
  })

  // 监听系统主题变化
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      const newTheme = e.matches ? 'dark' : 'light'
      html.setAttribute('data-theme', newTheme)
      updateIcon(newTheme)
    }
  })
</script>

<style is:global>
  /* Light 主题 */
  :root,
  [data-theme='light'] {
    --accent: #2563eb;
    --accent-dark: #1e40af;
    --black: #0a0a0a;
    --gray: #6b7280;
    --gray-light: #e5e7eb;
    --gray-dark: #374151;
    --gray-gradient: linear-gradient(180deg, #f9fafb, #fff);
    --box-shadow: 0 2px 6px -1px rgba(0, 0, 0, 0.1);

    --bg: #ffffff;
    --bg-secondary: #f9fafb;
    --bg-tertiary: #f3f4f6;
    --text: #111827;
    --text-secondary: #6b7280;
    --border: #e5e7eb;
    --code-bg: #f3f4f6;
    --pre-bg: #1f2937;
    --pre-text: #f9fafb;
  }

  /* Dark 主题 */
  [data-theme='dark'] {
    --accent: #60a5fa;
    --accent-dark: #3b82f6;
    --black: #f9fafb;
    --gray: #9ca3af;
    --gray-light: #374151;
    --gray-dark: #d1d5db;
    --gray-gradient: linear-gradient(180deg, #1f2937, #111827);
    --box-shadow: 0 2px 6px -1px rgba(0, 0, 0, 0.5);

    --bg: #111827;
    --bg-secondary: #1f2937;
    --bg-tertiary: #374151;
    --text: #f9fafb;
    --text-secondary: #9ca3af;
    --border: #374151;
    --code-bg: #1f2937;
    --pre-bg: #0f172a;
    --pre-text: #e5e7eb;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: system-ui, sans-serif;
    background: var(--bg-secondary);
    background-size: 224px;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  header {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  header nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  header nav a {
    color: var(--gray-dark);
    text-decoration: none;
    font-weight: 500;
  }

  /* RSS icon: first item on the right edge. */
  header nav .rss-link {
    margin-left: auto;
  }

  /* Sort toggle: single icon that morphs between fetch (inbox) and pub
     (calendar). Both SVGs live in the DOM; the active one is shown via
     the [data-sort-toggle="..."] attribute selector so the client script
     only has to flip one attribute, not re-render markup. The non-default
     mode (pub) lights up with --accent so the user can read "I've
     deviated from default" at a glance. */
  header nav .sort-icon {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem;
    border-radius: 0.375rem;
    color: var(--gray-dark);
    transition: all 0.15s ease;
  }
  header nav .sort-icon:hover {
    color: var(--accent);
    background: var(--bg-tertiary);
  }
  header nav .sort-icon__fetch,
  header nav .sort-icon__pub {
    width: 16px;
    height: 16px;
  }
  header nav .sort-icon__pub {
    display: none;
  }
  header nav .sort-icon[data-sort-toggle='pub'] .sort-icon__fetch {
    display: none;
  }
  header nav .sort-icon[data-sort-toggle='pub'] .sort-icon__pub {
    display: block;
  }
  header nav .sort-icon[data-sort-toggle='pub'] {
    background: var(--accent);
    color: white;
  }
  header nav .sort-icon[data-sort-toggle='pub']:hover {
    background: var(--accent);
    color: white;
  }

  /* GitHub icon: same right-aligned cluster, immediately after RSS. */
  header nav .github-link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem;
    border-radius: 0.375rem;
    color: var(--gray-dark);
  }
  header nav .github-link:hover {
    color: var(--accent);
    background: var(--bg-tertiary);
  }

  /* Active nav link: change background to indicate current route. */
  header nav .nav-link {
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  header nav .nav-link:hover {
    background: var(--bg-secondary);
  }
  header nav .nav-link--active {
    background: var(--accent);
    color: white;
  }
  header nav .nav-link--active:hover {
    background: var(--accent);
  }

  header nav a .rss-icon {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }

  header nav a:hover {
    color: var(--accent);
  }

  header nav a:hover .rss-icon {
    opacity: 1;
  }

  /* 主题切换按钮 */
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.375rem;
    cursor: pointer;
    color: var(--gray-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .theme-toggle:hover {
    background: var(--bg-tertiary);
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle .sun-icon,
  .theme-toggle .moon-icon {
    display: none;
  }

  footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    text-align: center;
    color: var(--gray);
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 1.5rem 0 0.75rem;
    line-height: 1.2;
    color: var(--text);
  }

  h1 {
    font-size: 2.25rem;
  }
  h2 {
    font-size: 1.875rem;
  }
  h3 {
    font-size: 1.5rem;
  }

  p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--text);
  }
  ul,
  ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  li {
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  code {
    background: var(--code-bg);
    color: var(--text);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  pre {
    background: var(--pre-bg);
    color: var(--pre-text);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  blockquote {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin-left: 0;
    color: var(--text-secondary);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* 高亮标注样式 - 用于文章重点内容 */
  .highlight {
    padding: 2px 4px;
    border-radius: 3px;
  }

  [data-theme='light'] .highlight {
    background-color: #fff3cd;
  }

  [data-theme='dark'] .highlight {
    background-color: #4b5563;
  }
</style>
