---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadKbCurioConfig } from '../load-config.ts';

const cfg = await loadKbCurioConfig();

type Article = CollectionEntry<'article'>;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const articleHref = (a: Article) =>
  `${base}article/${a.id.replace(/^\d{6}\//, '').replace(/\.mdx?$/, '')}`;

// Sort by `effectiveDate = fetchDate ?? pubDate` — the home page "latest"
// reflects what this collection last touched, mirroring the RSS feed
// semantics. Articles without fetchDate fall back to pubDate.
const latestArticles = (await getCollection('article'))
  .filter((a: Article) => !a.data.draft)
  .sort(
    (a: Article, b: Article) =>
      +new Date(b.data.fetchDate ?? b.data.pubDate ?? 0) -
      +new Date(a.data.fetchDate ?? a.data.pubDate ?? 0),
  )
  .slice(0, 10);

const iso = (d: Date | undefined): string => (d ? d.toISOString().slice(0, 10) : '');
---
<BaseLayout>
  <section class="hero">
    <h1>{cfg.site.title}</h1>
    {cfg.site.description && <p>{cfg.site.description}</p>}
  </section>

  <section class="latest">
    <h2>最新文章</h2>
    {latestArticles.length === 0 ? (
      <p class="empty">还没有内容。在 <code>{cfg.dataDir}/article/</code> 下添加文章后，首页会自动展示。</p>
    ) : (
      <ul class="article-list" data-article-list>
        {latestArticles.map((a: Article) => (
          <li
            class="article-item"
            data-pub-date={iso(a.data.pubDate)}
            data-fetch-date={iso(a.data.fetchDate)}
          >
            <time class="article-item__pub">{iso(a.data.pubDate)}</time>
            <a href={articleHref(a)} class="article-item__title">{a.data.title ?? a.id}</a>
            <time class="article-item__fetch">{iso(a.data.fetchDate)}</time>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .hero p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto;
  }

  .latest {
    margin-bottom: 2.5rem;
  }
  .latest h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article-item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 7rem;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .article-item:last-child {
    border-bottom: none;
  }
  /* Use the more-specific .article-list .article-item__title selector
     so the color rule wins over the `a { color: var(--accent) }` global
     rule (and the `.article-body a` rule on detail pages). Without the
     extra specificity, a-list-page article links render in accent blue
     instead of the intended near-black. */
  .article-list .article-item__title {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .article-list .article-item__title:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .article-item__pub,
  .article-item__fetch {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .article-item__pub {
    color: var(--text-secondary);
    opacity: 0.7;
    justify-self: start;
  }
  .article-item__pub:empty::before {
    content: '—';
  }
  .article-item__fetch {
    color: var(--text-secondary);
    justify-self: end;
  }
  .article-item__fetch:empty::before {
    content: '—';
  }
  .empty {
    color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .article-item {
      grid-template-columns: 5.5rem minmax(0, 1fr) 5.5rem;
      gap: 0.5rem;
    }
  }
</style>
